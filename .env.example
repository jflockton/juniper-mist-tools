# Mist cloud API endpoint for your organisation's region.
API_URL=https://api.eu.mist.com

# Mist API token. Never commit a real token.
MIST_API_KEY=replace-with-api-token

# Mist organisation UUID.
ORG_ID=replace-with-organisation-id

# Safety lock: keep false for production environments.
ENABLE_NON_PRODUCTION_VLAN_COPY=false
